<!DOCTYPE html>
<html lang="en" class="scroll-smooth">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chat | Chat App</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = { darkMode: 'class' }
    </script>
</head>

<body class="bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 transition-colors h-screen flex flex-col">

    <!-- Navbar -->
    <header class="bg-white/80 dark:bg-gray-900/80 backdrop-blur-sm border-b border-gray-200 dark:border-gray-700">
        <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
            <!-- Logo -->
            <h1 class="text-2xl font-bold text-blue-600 dark:text-blue-400">Chat App</h1>

            <!-- Desktop Nav -->
            <nav class="hidden md:flex items-center gap-4">
                <!-- Search -->
                <div class="relative">
                    <input type="text" id="searchGlobal" placeholder="Search teams..."
                        class="px-4 py-2 rounded-lg bg-gray-100 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-400" />
                    <span class="absolute right-3 top-2.5">🔍</span>

                    <!-- Dropdown -->
                    <ul id="searchDropdown"
                        class="absolute left-0 mt-1 w-full bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg shadow-lg hidden z-50">
                    </ul>
                </div>


                <!-- Create -->
                <a href="http://localhost:3000/api/client/create-room"
                    class="px-4 py-2 bg-blue-600 text-white rounded-lg shadow hover:bg-blue-700 dark:hover:bg-blue-500 transition w-full">
                    🚀 Create room
                </a>

                <!-- Theme toggle -->
                <button id="theme-toggle"
                    class="p-2 rounded-full bg-gray-200 dark:bg-gray-700 hover:bg-gray-300 dark:hover:bg-gray-600 transition">
                    🌙
                </button>
            </nav>


            <!-- Theme + Hamburger (Mobile) -->
            <div class="flex items-center gap-3 md:hidden">
                <button id="theme-toggle-mobile" class="p-2 rounded-full bg-gray-200 dark:bg-gray-700">🌙</button>
                <button id="menu-btn" class="p-2 rounded bg-gray-200 dark:bg-gray-700">
                    ☰
                </button>
            </div>
        </div>

        <!-- Mobile Dropdown -->
        <div id="menu-dropdown"
            class="hidden flex-col space-y-4 px-4 py-4 bg-white dark:bg-gray-900 border-t border-gray-200 dark:border-gray-700 md:hidden">
            <!-- Search -->
            <div class="relative">
                <input type="text" id="searchGlobalMobile" placeholder="Search teams..."
                    class="px-4 py-2 rounded-lg bg-gray-100 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-400" />
                <span class="absolute right-3 top-2.5">🔍</span>

                <!-- Dropdown -->
                <ul id="searchDropdownMobile"
                    class="absolute left-0 mt-1 w-full bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg shadow-lg hidden z-50">
                </ul>
            </div>

        </div>
        <!-- Create -->
        <!-- <a href="http://localhost:3000/api/client/create-room"
            class="px-4 py-2 bg-blue-600 text-white rounded-lg shadow hover:bg-blue-700 dark:hover:bg-blue-500 transition w-full">
            🚀 Create room
        </a> -->
        <!-- Links -->
        <!-- <a href="#" class="block hover:text-blue-600 dark:hover:text-blue-400">Home</a>
        <a href="#" class="block hover:text-blue-600 dark:hover:text-blue-400">Features</a>
        <a href="#" class="block hover:text-blue-600 dark:hover:text-blue-400">About</a> -->
        </div>

    </header>

    <script>
        // Mobile menu toggle
        document.getElementById("menu-btn").addEventListener("click", () => {
            document.getElementById("menu-dropdown").classList.toggle("hidden");
        });
    </script>

    <!-- Main Layout -->
    <div class="flex flex-1 overflow-hidden">

        <!-- Sidebar (Chats List) -->
        <aside id="chat-list"
            class="w-full md:w-1/3 lg:w-1/4 border-r border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 overflow-y-auto transition-all">
            <!-- Search Bar -->
            <div class="p-3">
                <input type="text" id="searchTeamClientSide" placeholder="Search teams..."
                    class="w-full px-3 py-2 rounded-lg bg-gray-100 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-400">
            </div>
            <!-- Chats -->
            <ul id="team-list">
            </ul>
        </aside>

        <!-- Chat Area -->
        <main id="chat-area" class="hidden md:flex flex-col flex-1 bg-gray-50 dark:bg-gray-900">

            <!-- Chat Header -->
            <div class="flex items-center justify-between p-4 border-b border-gray-200 dark:border-gray-700">
                <div class="flex items-center gap-2">
                    <button id="back-btn" class="p-2 rounded bg-gray-200 dark:bg-gray-700">
                        < </button>
                            <h2 id="chat-title" class="font-bold text-lg">Select a team</h2>
                </div>
                <div></div>
            </div>

            <!-- Messages (scrollable) -->
            <div id="messages" class="flex-1 overflow-y-auto p-4 space-y-3">
                <p class="text-gray-400 text-center">No chat selected</p>
            </div>

            <!-- Input Bar (BOTTOM, fixed in layout) -->
            <div
                class="p-3 border-t border-gray-200 dark:border-gray-700 flex items-center gap-2 bg-white dark:bg-gray-800">
                <input type="text" placeholder="Type a message..." id="msgInputbtn"
                    class="flex-1 px-3 py-2 rounded-lg bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-400">
                <button id="sendbtn"
                    class="px-4 py-2 bg-blue-600 dark:bg-blue-500 text-white rounded-lg hover:bg-blue-700 dark:hover:bg-blue-600">
                    ➤
                </button>
            </div>
        </main>

        </main>

    </div>

    <script>
        // Theme persistence
        if (localStorage.getItem("theme") === "dark") {
            document.documentElement.classList.add("dark");
        }
        const toggleTheme = () => {
            const isDark = document.documentElement.classList.toggle("dark");
            localStorage.setItem("theme", isDark ? "dark" : "light");
        };
        document.getElementById("theme-toggle").addEventListener("click", toggleTheme);

        // Open Chat
        function openChat(teamName) {
            document.getElementById("chat-title").innerText = teamName;
            document.getElementById("chat-list").classList.add("hidden");
            document.getElementById("chat-area").classList.remove("hidden");
        }

        // Back button for mobile
        document.getElementById("back-btn").addEventListener("click", () => {
            document.getElementById("chat-area").classList.add("hidden");
            document.getElementById("chat-list").classList.remove("hidden");
        });

        // ✅ Helper: Append outgoing (right) message
        function appendOutgoingMessage(text) {
            const messages = document.getElementById("messages");
            const msg = document.createElement("div");
            msg.className = "self-end bg-blue-600 text-white p-2 rounded-lg max-w-xs";
            msg.textContent = text;
            messages.appendChild(msg);
            messages.scrollTop = messages.scrollHeight; // auto scroll
        }
        function appendIncomingMessage(text) {
            const messages = document.getElementById("messages");
            const msg = document.createElement("div");
            msg.className = "self-start bg-gray-200 dark:bg-gray-700 p-2 rounded-lg max-w-xs";
            msg.textContent = text;
            messages.appendChild(msg);
            messages.scrollTop = messages.scrollHeight; // auto scroll
        }
    </script>
    <script> // for searching
        const searchInput = document.getElementById("searchTeamClientSide");

        searchInput.addEventListener("input", () => {
            const query = searchInput.value.trim().toLowerCase();
            const rooms = document.querySelectorAll("#team-list li");

            rooms.forEach(li => {
                const roomName = li.querySelector(".roomName").innerText.toLowerCase();

                if (query && roomName.includes(query)) {
                    // Add highlight
                    li.classList.add("bg-blue-100", "dark:bg-blue-800");

                    // Remove highlight after 2 seconds
                    setTimeout(() => {
                        li.classList.remove("bg-blue-100", "dark:bg-blue-800");
                    }, 2000);
                }
            });
        });
    </script>
    <script src="/socket.io/socket.io.js"></script>
    <script>
        const token = document.cookie.split("=")[1]
        const socket = io()
        //  fetching the team data from server in streams so used the socket connection for continuous data

        showLoadingTeams();
        socket.on('connect', () => {
            console.log("Connected with server server id is", socket.id);
            const userName = "<%= userName %>"
            socket.emit('fetch-userData', userName)
        })
        socket.on('user-dataFetched', (teamArr) => {
            teamArr = [...JSON.parse(teamArr)]
            if (!teamArr.length) {
                console.log("No real data got so keeping the same as before");
                return;
            }
            const ul = document.getElementById("team-list");
            ul.innerHTML = ""
            console.log(typeof teamArr);
            teamArr.forEach(team => {
                appendTeam(team)
            });
            setTimeout(() => {
                socket.emit('Fetch-complete'), 1000
            })
            socket.on('newUser', (socketID) => {
                console.log("New user Connected to the Room ", socketID);
            })
            socket.on('gotMsg', (msg) => {
                appendIncomingMessage(msg)
            })
        })
        function showLoadingTeams(count = 5) {
            const ul = document.getElementById("team-list");
            ul.innerHTML = ""; // Clear old stuff

            for (let i = 0; i < count; i++) {
                const li = document.createElement("li");
                li.className =
                    "p-4 border-b border-gray-200 dark:border-gray-700 animate-pulse";

                li.innerHTML = `
                <div class="h-4 bg-gray-300 dark:bg-gray-600 rounded w-1/2 mb-2"></div>
                <div class="h-3 bg-gray-200 dark:bg-gray-700 rounded w-1/3"></div>
            `;
                ul.appendChild(li);
            }
        }

        function appendTeam(team) {
            const ul = document.getElementById("team-list");

            // always clear out loading skeletons before appending first real team
            if (ul.innerHTML.includes("animate-pulse")) {
                ul.innerHTML = "";
            }

            const li = document.createElement("li");
            li.className =
                "p-4 border-b border-gray-200 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-gray-700 cursor-pointer";
            li.innerHTML = `
        <h3 class="font-semibold roomName">${team.teamName}</h3>
        <p class="text-sm text-gray-500 dark:text-gray-400">
            ${team.members?.length || 0} members
        </p>
    `;
            li.addEventListener("click", () => {
                const Room = document.querySelector('.roomName').innerText
                socket.emit('joinRoom', Room, socket.id);
                openChat(team.teamName)
            }
            );
            ul.appendChild(li);
        }

        document.getElementById('sendbtn').addEventListener('click', () => {
            const msg = document.getElementById('msgInputbtn')
            const roomTitle = document.getElementById('chat-title').innerText
            appendOutgoingMessage(msg.value.trim())
            socket.emit('send-msg', msg.value.trim(), roomTitle)
            msg.value = ""
        })
    </script>
    <script> // for global team search
        function setupSearch(inputId, dropdownId) {
            const searchInput = document.getElementById(inputId);
            const searchDropdown = document.getElementById(dropdownId);

            let searchTimeout;

            searchInput.addEventListener("input", () => {
                const query = searchInput.value.trim();

                clearTimeout(searchTimeout);

                if (!query) {
                    searchDropdown.classList.add("hidden");
                    searchDropdown.innerHTML = "";
                    return;
                }

                searchTimeout = setTimeout(() => {
                    socket.emit("search-teams", query);
                }, 300);
            });
            socket.on("search-results", (teams) => {
                console.log('search-results' , teams);
                searchDropdown.innerHTML = "";

                if (!teams.length) {
                    searchDropdown.classList.add("hidden");
                    return;
                }

                teams.forEach(team => {
                    const li = document.createElement("li");
                    li.className =
                        "px-4 py-2 hover:bg-blue-100 dark:hover:bg-blue-800 cursor-pointer";
                    li.textContent = team.teamName;

                    li.addEventListener("click", () => {
                        socket.emit("joinRoom", team.teamName, socket.id , token);
                        openChat(team.teamName);
                        searchDropdown.classList.add("hidden");
                        searchDropdown.innerHTML = "";
                        searchInput.value = "";
                    });

                    searchDropdown.appendChild(li);
                });
                searchDropdown.classList.remove("hidden");
                searchDropdown.classList.add('z-99')
            });
        }

        setupSearch("searchGlobal", "searchDropdown");       // desktop
        setupSearch("searchGlobalMobile", "searchDropdownMobile"); // mobile

    </script>
</body>

</html>